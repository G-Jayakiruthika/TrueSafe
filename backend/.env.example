# Copy to .env (never commit .env). On Cloud Run use Secret Manager instead.
NODE_ENV=production
PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=change-me-to-64-random-bytes-hex
CSRF_SECRET=change-me-to-64-random-bytes-hex
WEBHOOK_SECRET=shared-secret-configured-in-twilio-or-vapi
ALLOWED_ORIGINS=https://truesafe.example.com
# Mock OTP login ('1234'). MUST be false in real production.
MOCK_OTP=true
# Supabase: URL + anon key are public-safe (RLS enforced). Service key is server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
